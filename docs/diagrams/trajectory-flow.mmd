flowchart TB
    accTitle: Planned trajectory preparation and exploration flow
    accDescr: Uploaded GPS data is preserved, normalised, checked, simplified, and stored. User filters then drive subtrajectory extraction and route grouping, and the results are displayed on a map for further inspection.

    subgraph preparation[Dataset preparation]
        direction LR
        upload[Uploaded GPS dataset]
        preserve[Preserve original<br/>observations]
        normalise[Normalise journey IDs,<br/>coordinates and timestamps]
        validate[Detect invalid positions,<br/>times and movement]
        simplify[Compress Data while preserving<br/>route shape and timing]
        storeOriginal[(Original<br/>trajectories)]
        storePrepared[(Prepared<br/>trajectories)]

        upload --> preserve --> storeOriginal
        upload --> normalise --> validate --> simplify --> storePrepared
    end

    subgraph exploration[Interactive route exploration]
        direction LR
        filters[Select dataset area, timestamp and route similarity filter]
        query[Query candidate<br/>prepared trajectories]
        extract[Find subtrajectories]
        cluster[Group substantially<br/>similar paths]
        result[Representative routes,<br/>counts, IDs and timestamps]

        filters --> query --> extract --> cluster --> result
    end

    preparation -->|Prepared trajectories| exploration

    classDef input fill:#fff4cc,stroke:#76520e,color:#2c2109,stroke-width:1.5px;
    classDef process fill:#e9f8ef,stroke:#237a46,color:#123d26,stroke-width:1.5px;
    classDef store fill:#f4eafe,stroke:#7446a6,color:#35204d,stroke-width:1.5px;
    classDef interaction fill:#e8f1ff,stroke:#245ea8,color:#102a43,stroke-width:1.5px;

    class upload input;
    class preserve,normalise,validate,simplify,query,extract,cluster process;
    class storeOriginal,storePrepared store;
    class filters,result, interaction;
